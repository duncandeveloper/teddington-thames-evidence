# Normalise line endings. Windows editors and OneDrive were rewriting whole
# files to CRLF, producing 200+ line phantom diffs on every checkout.
# Everything in this repo is committed and checked out as LF.
* text=auto eol=lf

# Text formats, explicit (some are ambiguous to auto-detection)
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.webmanifest   text eol=lf

# Binary — never touch, never diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.pdf    binary
*.zip    binary
